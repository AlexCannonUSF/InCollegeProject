>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TestRunner.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TEST-INPUT-FILE ASSIGN TO "data/input.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INPUT-STATUS.
    SELECT APP-INPUT-FILE ASSIGN TO "data/InCollege-Input.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-APP-INPUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD TEST-INPUT-FILE.
01 TEST-INPUT-RECORD PIC X(300).

FD APP-INPUT-FILE.
01 APP-INPUT-RECORD PIC X(300).

WORKING-STORAGE SECTION.
77 WS-INPUT-STATUS PIC XX VALUE "00".
77 WS-APP-INPUT-STATUS PIC XX VALUE "00".
77 WS-EOF PIC X VALUE "N".
77 WS-CMD PIC X(512) VALUE SPACES.
77 WS-RETURN-CODE PIC S9(4) COMP VALUE 0.

PROCEDURE DIVISION.
MAIN.
    PERFORM COPY-TEST-INPUT
    MOVE SPACES TO WS-CMD
    STRING "./bin/InCollege < data/InCollege-Input.txt" DELIMITED BY SIZE
        INTO WS-CMD
    END-STRING
    CALL "SYSTEM" USING WS-CMD RETURNING WS-RETURN-CODE
    GOBACK.

COPY-TEST-INPUT.
    MOVE "N" TO WS-EOF
    OPEN INPUT TEST-INPUT-FILE
    IF WS-INPUT-STATUS NOT = "00"
        DISPLAY "Unable to open data/input.txt"
        STOP RUN
    END-IF

    OPEN OUTPUT APP-INPUT-FILE
    IF WS-APP-INPUT-STATUS NOT = "00"
        DISPLAY "Unable to create data/InCollege-Input.txt"
        CLOSE TEST-INPUT-FILE
        STOP RUN
    END-IF

    PERFORM UNTIL WS-EOF = "Y"
        READ TEST-INPUT-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                MOVE TEST-INPUT-RECORD TO APP-INPUT-RECORD
                WRITE APP-INPUT-RECORD
        END-READ
    END-PERFORM

    CLOSE TEST-INPUT-FILE
    CLOSE APP-INPUT-FILE.
