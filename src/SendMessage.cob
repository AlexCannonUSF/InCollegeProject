>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. SendMessage.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
       SELECT ESTABLISHED-CONNECTIONS-FILE ASSIGN TO "data/EstablishedConnections.dat"
       ORGANIZATION IS SEQUENTIAL
       ACCESS MODE IS SEQUENTIAL
       FILE STATUS IS WS-CONNECTIONS-FILE-STATUS.

       SELECT MESSAGE-FILE ASSIGN TO "data/Messages.dat"
       ORGANIZATION IS LINE SEQUENTIAL
       FILE STATUS IS WS-MESSAGE-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
       FD ESTABLISHED-CONNECTIONS-FILE.
       01 ESTABLISHED-CONNECTIONS-RECORD.
           05 CONNECTION-USER-ONE PIC X(30).
           05 CONNECTION-USER-TWO PIC X(30).

       FD MESSAGE-FILE.
       01 MESSAGE-RECORD.
           05 MESSAGE-SENDER       PIC X(30).
           05 MESSAGE-RECIPIENT    PIC X(30).
           05 MESSAGE-CONTENT      PIC X(200).
           05 MESSAGE-TIMESTAMP    PIC X(25).

WORKING-STORAGE SECTION.
01 RECIPIENT-USERNAME          PIC X(30).
01 MESSAGE-BODY                PIC X(200).
01 WS-EOF-CONNECTIONS          PIC X VALUE 'N'.
01 WS-IS-CONNECTED             PIC X VALUE 'N'.
77 WS-CONNECTIONS-FILE-STATUS  PIC XX VALUE "00".
77 WS-MESSAGE-FILE-STATUS      PIC XX VALUE "00".
01 WS-FORMATTED-TIMESTAMP      PIC X(25).
01 WS-CURRENT-DATE-DATA.       
       05 WS-CURRENT-YEAR      PIC 9(4).
       05 WS-CURRENT-MONTH     PIC 9(2).
       05 WS-CURRENT-DAY       PIC 9(2).

       05 WS-CURRENT-HOUR      PIC 9(2).
       05 WS-CURRENT-MINUTE    PIC 9(2).
       05 WS-CURRENT-SECOND      PIC 9(2).
       05 WS-CURRENT-MILLISECOND PIC 9(2).

       05 WS-UNUSED            PIC X(5).

LINKAGE SECTION.
01 LNK-USER-NAME       PIC X(30).

PROCEDURE DIVISION USING LNK-USER-NAME.
MAIN.
       DISPLAY "Enter recipient's username (must be a connection): "
       ACCEPT RECIPIENT-USERNAME
       DISPLAY RECIPIENT-USERNAME

       MOVE 'N' TO WS-IS-CONNECTED
       MOVE 'N' TO WS-EOF-CONNECTIONS

       OPEN INPUT ESTABLISHED-CONNECTIONS-FILE

       IF WS-CONNECTIONS-FILE-STATUS = "35"
           MOVE 'N' TO WS-IS-CONNECTED
       ELSE
           PERFORM UNTIL WS-EOF-CONNECTIONS = 'Y' OR WS-IS-CONNECTED = 'Y'
               READ ESTABLISHED-CONNECTIONS-FILE
                   AT END MOVE 'Y' TO WS-EOF-CONNECTIONS
                   NOT AT END
                       IF (FUNCTION TRIM(LNK-USER-NAME) = FUNCTION TRIM(CONNECTION-USER-ONE) AND FUNCTION TRIM(RECIPIENT-USERNAME) = FUNCTION TRIM(CONNECTION-USER-TWO)) OR (FUNCTION TRIM(RECIPIENT-USERNAME) = FUNCTION TRIM(CONNECTION-USER-ONE) AND FUNCTION TRIM(LNK-USER-NAME) = FUNCTION TRIM(CONNECTION-USER-TWO))
                           MOVE 'Y' TO WS-IS-CONNECTED
                       END-IF
               END-READ
           END-PERFORM
           CLOSE ESTABLISHED-CONNECTIONS-FILE
       END-IF

       IF WS-IS-CONNECTED = 'N'
           DISPLAY "User not found in your network. You can only message users you are connected with."
           DISPLAY "---------------------"
           GOBACK
       END-IF

       DISPLAY "Enter your message (max 200 chars): "
       ACCEPT MESSAGE-BODY
       DISPLAY MESSAGE-BODY

       MOVE FUNCTION CURRENT-DATE TO WS-CURRENT-DATE-DATA

       STRING
           WS-CURRENT-MONTH    "/"     *>month
           WS-CURRENT-DAY      "/"     *>day
           WS-CURRENT-YEAR    " @ "   *>year
           WS-CURRENT-HOUR    ":"     *>hour
           WS-CURRENT-MINUTE  ":"     *>mins
           WS-CURRENT-SECOND
           DELIMITED BY SIZE
           INTO WS-FORMATTED-TIMESTAMP

       OPEN INPUT MESSAGE-FILE
       IF WS-MESSAGE-FILE-STATUS = "35"
           OPEN OUTPUT MESSAGE-FILE
           CLOSE MESSAGE-FILE
       ELSE
           CLOSE MESSAGE-FILE
       END-IF

       OPEN EXTEND MESSAGE-FILE

       MOVE SPACES TO MESSAGE-RECORD
       MOVE LNK-USER-NAME TO MESSAGE-SENDER
       MOVE RECIPIENT-USERNAME TO MESSAGE-RECIPIENT
       MOVE MESSAGE-BODY TO MESSAGE-CONTENT
       MOVE WS-FORMATTED-TIMESTAMP TO MESSAGE-TIMESTAMP

       WRITE MESSAGE-RECORD
       CLOSE MESSAGE-FILE

       DISPLAY "Message sent to " FUNCTION TRIM(RECIPIENT-USERNAME) " successfully!".
       GOBACK.
END PROGRAM SendMessage.