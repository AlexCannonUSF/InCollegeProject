>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. Jobs.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT JOB-POSTINGS-FILE ASSIGN TO "data/JobPostings.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-JOB-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD JOB-POSTINGS-FILE.
01 JOB-POSTING-RECORD.
    05 JOB-ID PIC 9(4).
    05 JOB-POSTED-BY PIC X(30).
    05 JOB-TITLE PIC X(50).
    05 JOB-DESCRIPTION PIC X(200).
    05 JOB-EMPLOYER PIC X(50).
    05 JOB-LOCATION PIC X(50).
    05 JOB-SALARY PIC X(15).                                         

WORKING-STORAGE SECTION.
77 WS-MENU-CHOICE PIC X VALUE SPACE.
77 WS-EXIT-MENU PIC X VALUE "N".
77 WS-JOB-FILE-STATUS PIC XX VALUE "00".
77 WS-JOB-FILE-EOF PIC X VALUE "N".
77 WS-LAST-JOB-ID PIC 9(4) VALUE 0.
77 WS-NEXT-JOB-ID PIC 9(4) VALUE 1.
77 WS-SAVE-SUCCESSFUL PIC X VALUE "N".
77 WS-JOB-TITLE PIC X(50) VALUE SPACES.
77 WS-JOB-DESCRIPTION PIC X(200) VALUE SPACES.
77 WS-JOB-EMPLOYER PIC X(50) VALUE SPACES.
77 WS-JOB-LOCATION PIC X(50) VALUE SPACES.
77 WS-JOB-SALARY PIC X(15) VALUE SPACES.
LINKAGE SECTION.
01 LNK-USER-NAME PIC X(30).

PROCEDURE DIVISION USING LNK-USER-NAME.                                 

MAIN.
    MOVE "N" TO WS-EXIT-MENU                                            
    PERFORM UNTIL WS-EXIT-MENU = "Y"                                    
        DISPLAY "--- Job Search/Internship Menu ---"
        DISPLAY "1. Post a Job/Internship"
        DISPLAY "2. Browse Jobs/Internships"
        DISPLAY "3. Back to Main Menu"
        DISPLAY "Enter your choice:"
        ACCEPT WS-MENU-CHOICE
        INSPECT WS-MENU-CHOICE REPLACING ALL X"0D" BY SPACE
        INSPECT WS-MENU-CHOICE REPLACING ALL X"0A" BY SPACE
        DISPLAY FUNCTION TRIM(WS-MENU-CHOICE)

        IF FUNCTION TRIM(WS-MENU-CHOICE) = SPACE
            MOVE "Y" TO WS-EXIT-MENU
        ELSE
            EVALUATE WS-MENU-CHOICE
                WHEN "1"
                    PERFORM POST-JOB-LISTING
                WHEN "2"
                    CALL "ViewJobs" USING LNK-USER-NAME
                WHEN "3"
                    MOVE "Y" TO WS-EXIT-MENU
                WHEN OTHER
                    DISPLAY "Invalid choice. Please try again."
            END-EVALUATE
        END-IF
    END-PERFORM
    GOBACK.

POST-JOB-LISTING.
    DISPLAY "--- Post a New Job/Internship ---"
    PERFORM PROMPT-JOB-TITLE
    PERFORM PROMPT-JOB-DESCRIPTION
    PERFORM PROMPT-JOB-EMPLOYER
    PERFORM PROMPT-JOB-LOCATION
    PERFORM PROMPT-JOB-SALARY
    PERFORM SAVE-JOB-LISTING.

PROMPT-JOB-TITLE.
    MOVE SPACES TO WS-JOB-TITLE
    PERFORM UNTIL FUNCTION TRIM(WS-JOB-TITLE) NOT = SPACE
        DISPLAY "Enter Job Title:"
        ACCEPT WS-JOB-TITLE
        INSPECT WS-JOB-TITLE REPLACING ALL X"0D" BY SPACE
        INSPECT WS-JOB-TITLE REPLACING ALL X"0A" BY SPACE
        DISPLAY FUNCTION TRIM(WS-JOB-TITLE)
        IF FUNCTION TRIM(WS-JOB-TITLE) = SPACE
            DISPLAY "Job title is required."
        END-IF
    END-PERFORM.

PROMPT-JOB-DESCRIPTION.
    MOVE SPACES TO WS-JOB-DESCRIPTION
    PERFORM UNTIL FUNCTION TRIM(WS-JOB-DESCRIPTION) NOT = SPACE
        DISPLAY "Enter Description (max 200 chars):"
        ACCEPT WS-JOB-DESCRIPTION
        INSPECT WS-JOB-DESCRIPTION REPLACING ALL X"0D" BY SPACE
        INSPECT WS-JOB-DESCRIPTION REPLACING ALL X"0A" BY SPACE
        DISPLAY FUNCTION TRIM(WS-JOB-DESCRIPTION)
        IF FUNCTION TRIM(WS-JOB-DESCRIPTION) = SPACE
            DISPLAY "Description is required."
        END-IF
    END-PERFORM.

PROMPT-JOB-EMPLOYER.
    MOVE SPACES TO WS-JOB-EMPLOYER
    PERFORM UNTIL FUNCTION TRIM(WS-JOB-EMPLOYER) NOT = SPACE
        DISPLAY "Enter Employer Name:"
        ACCEPT WS-JOB-EMPLOYER
        INSPECT WS-JOB-EMPLOYER REPLACING ALL X"0D" BY SPACE
        INSPECT WS-JOB-EMPLOYER REPLACING ALL X"0A" BY SPACE
        DISPLAY FUNCTION TRIM(WS-JOB-EMPLOYER)
        IF FUNCTION TRIM(WS-JOB-EMPLOYER) = SPACE
            DISPLAY "Employer is required."
        END-IF
    END-PERFORM.

PROMPT-JOB-LOCATION.
    MOVE SPACES TO WS-JOB-LOCATION
    PERFORM UNTIL FUNCTION TRIM(WS-JOB-LOCATION) NOT = SPACE
        DISPLAY "Enter Location:"
        ACCEPT WS-JOB-LOCATION
        INSPECT WS-JOB-LOCATION REPLACING ALL X"0D" BY SPACE
        INSPECT WS-JOB-LOCATION REPLACING ALL X"0A" BY SPACE
        DISPLAY FUNCTION TRIM(WS-JOB-LOCATION)
        IF FUNCTION TRIM(WS-JOB-LOCATION) = SPACE
            DISPLAY "Location is required."
        END-IF
    END-PERFORM.

PROMPT-JOB-SALARY.
    MOVE SPACES TO WS-JOB-SALARY
    DISPLAY "Enter Salary (Optional):"
    ACCEPT WS-JOB-SALARY
    INSPECT WS-JOB-SALARY REPLACING ALL X"0D" BY SPACE
    INSPECT WS-JOB-SALARY REPLACING ALL X"0A" BY SPACE
    IF FUNCTION TRIM(WS-JOB-SALARY) = SPACE                             
       MOVE "Not specified" TO WS-JOB-SALARY                            
    END-IF
    DISPLAY FUNCTION TRIM(WS-JOB-SALARY).

SAVE-JOB-LISTING.
    MOVE "N" TO WS-SAVE-SUCCESSFUL
    PERFORM FIND-NEXT-JOB-ID

    MOVE WS-NEXT-JOB-ID TO JOB-ID
    MOVE LNK-USER-NAME TO JOB-POSTED-BY
    MOVE WS-JOB-TITLE TO JOB-TITLE
    MOVE WS-JOB-DESCRIPTION TO JOB-DESCRIPTION
    MOVE WS-JOB-EMPLOYER TO JOB-EMPLOYER
    MOVE WS-JOB-LOCATION TO JOB-LOCATION
    MOVE WS-JOB-SALARY TO JOB-SALARY

    OPEN EXTEND JOB-POSTINGS-FILE
    IF WS-JOB-FILE-STATUS = "35"
        OPEN OUTPUT JOB-POSTINGS-FILE
        IF WS-JOB-FILE-STATUS = "00"
            CLOSE JOB-POSTINGS-FILE
            OPEN EXTEND JOB-POSTINGS-FILE
        END-IF
    END-IF

    IF WS-JOB-FILE-STATUS = "00"
        WRITE JOB-POSTING-RECORD
        IF WS-JOB-FILE-STATUS = "00"
            MOVE "Y" TO WS-SAVE-SUCCESSFUL
        END-IF
        CLOSE JOB-POSTINGS-FILE
    END-IF

    IF WS-SAVE-SUCCESSFUL = "Y"
        DISPLAY "Job posted successfully!"
    ELSE
        DISPLAY "Unable to post job listing."
    END-IF.

FIND-NEXT-JOB-ID.
    MOVE 0 TO WS-LAST-JOB-ID
    MOVE 1 TO WS-NEXT-JOB-ID
    MOVE "N" TO WS-JOB-FILE-EOF

    OPEN INPUT JOB-POSTINGS-FILE
    IF WS-JOB-FILE-STATUS = "00"
        PERFORM UNTIL WS-JOB-FILE-EOF = "Y"
            READ JOB-POSTINGS-FILE
                AT END
                    MOVE "Y" TO WS-JOB-FILE-EOF
                NOT AT END
                    MOVE JOB-ID TO WS-LAST-JOB-ID
            END-READ
        END-PERFORM
        CLOSE JOB-POSTINGS-FILE
        COMPUTE WS-NEXT-JOB-ID = WS-LAST-JOB-ID + 1
    END-IF.

END PROGRAM Jobs.
