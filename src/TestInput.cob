>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TestInput.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TEST-INPUT-FILE ASSIGN TO "data/input.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-INPUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD TEST-INPUT-FILE.
01 TEST-INPUT-RECORD PIC X(300).

WORKING-STORAGE SECTION.
77 WS-INPUT-STATUS PIC XX VALUE "00".
77 WS-EOF PIC X VALUE "N".
77 WS-OPENED PIC X VALUE "N".

LINKAGE SECTION.
77 LK-LENGTH PIC 9(4).
01 LK-RESPONSE PIC X(300).

PROCEDURE DIVISION USING LK-LENGTH LK-RESPONSE.
MAIN.
    IF LK-LENGTH = 0
        IF WS-OPENED = "Y"
            CLOSE TEST-INPUT-FILE
            MOVE "N" TO WS-OPENED
        END-IF
        MOVE SPACES TO LK-RESPONSE
        GOBACK
    END-IF

    IF WS-OPENED NOT = "Y"
        OPEN INPUT TEST-INPUT-FILE
        IF WS-INPUT-STATUS = "00"
            MOVE "Y" TO WS-OPENED
        END-IF
    END-IF

    IF WS-OPENED = "Y"
        READ TEST-INPUT-FILE
            AT END
                MOVE "Y" TO WS-EOF
                CLOSE TEST-INPUT-FILE
                MOVE "N" TO WS-OPENED
            NOT AT END
                MOVE TEST-INPUT-RECORD(1:LK-LENGTH) TO LK-RESPONSE(1:LK-LENGTH)
        END-READ

        IF WS-EOF = "Y"
            MOVE SPACES TO LK-RESPONSE
        END-IF
    ELSE
        ACCEPT LK-RESPONSE
    END-IF
    GOBACK.
