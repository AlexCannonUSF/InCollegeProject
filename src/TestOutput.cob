>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TestOutput.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TEST-OUTPUT-FILE ASSIGN TO "data/output.txt"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-OUTPUT-STATUS.

DATA DIVISION.
FILE SECTION.
FD TEST-OUTPUT-FILE.
01 TEST-OUTPUT-RECORD PIC X(300).

WORKING-STORAGE SECTION.
77 WS-OUTPUT-STATUS PIC XX VALUE "00".

LINKAGE SECTION.
77 LK-ACTION PIC X.
77 LK-TEXT PIC X(300).

PROCEDURE DIVISION USING LK-ACTION LK-TEXT.
MAIN.
    EVALUATE LK-ACTION
        WHEN "I"
            PERFORM INITIALIZE-OUTPUT
        WHEN "A"
            PERFORM APPEND-OUTPUT
        WHEN OTHER
            CONTINUE
    END-EVALUATE
    GOBACK.

INITIALIZE-OUTPUT.
    OPEN OUTPUT TEST-OUTPUT-FILE
    IF WS-OUTPUT-STATUS = "00"
        CLOSE TEST-OUTPUT-FILE
    END-IF.

APPEND-OUTPUT.
    OPEN EXTEND TEST-OUTPUT-FILE
    IF WS-OUTPUT-STATUS = "35"
        OPEN OUTPUT TEST-OUTPUT-FILE
        IF WS-OUTPUT-STATUS = "00"
            CLOSE TEST-OUTPUT-FILE
            OPEN EXTEND TEST-OUTPUT-FILE
        END-IF
    END-IF

    IF WS-OUTPUT-STATUS = "00"
        MOVE LK-TEXT TO TEST-OUTPUT-RECORD
        WRITE TEST-OUTPUT-RECORD
        CLOSE TEST-OUTPUT-FILE
    END-IF.

END PROGRAM TestOutput.
